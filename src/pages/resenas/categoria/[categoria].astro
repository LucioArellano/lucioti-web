---
// src/pages/resenas/categoria/[categoria].astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

// Función auxiliar para convertir texto a URL limpia (slug)
function crearSlug(texto: string) {
  return texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "") // Remueve acentos
    .replace(/\s+/g, '-');           // Reemplaza espacios por guiones
}

// 1. Generamos las rutas estáticas para cada categoría existente
export async function getStaticPaths() {
  const todasLasResenas = await getCollection('resenas');

  // Obtenemos las categorías únicas presentes en los archivos Markdown
  const categoriasUnicas = [...new Set(todasLasResenas.map((r) => r.data.categoria))];

  return categoriasUnicas.map((nombreCategoria) => {
    // Función auxiliar interna para la generación de rutas
    const slug = nombreCategoria
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/\s+/g, '-');

    // Filtramos las reseñas que pertenecen a esta categoría específica
    const resenasDeCategoria = todasLasResenas.filter(
      (r) => r.data.categoria === nombreCategoria
    );

    return {
      params: { categoria: slug },
      props: { 
        nombreCategoria, 
        resenas: resenasDeCategoria,
        todasLasCategorias: categoriasUnicas
      },
    };
  });
}

// 2. Recibimos los datos enviados por getStaticPaths
const { nombreCategoria, resenas, todasLasCategorias } = Astro.props;

// Ordenamos las reseñas filtradas por fecha de publicación
const resenasOrdenadas = resenas.sort(
  (a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime()
);
---

<Layout title={`Reseñas de ${nombreCategoria} | Lucioti`}>
  <Header />

  <main class="container resenas-page">
    <header class="page-header">
      <a href="/resenas" class="back-link">← Volver a todas las reseñas</a>
      <h1 class="titulo-pagina">Categoría: {nombreCategoria}</h1>
      <p class="descripcion-pagina">
        Explora nuestros análisis detallados y recomendaciones sobre {nombreCategoria.toLowerCase()}.
      </p>
    </header>

    <!-- Lista de categorías para cambiar rápidamente -->
    <div class="categorias-summary">
      <span class="label">Filtrar por otra categoría:</span>
      <div class="badges-group">
        <a href="/resenas" class="badge-cat-link">Todas</a>
        {todasLasCategorias.map((cat) => {
          const slugCat = crearSlug(cat);
          const esActiva = cat === nombreCategoria;
          return (
            <a 
              href={`/resenas/categoria/${slugCat}`} 
              class={`badge-cat-link ${esActiva ? 'activa' : ''}`}
            >
              {cat}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Grid con las reseñas filtradas -->
    <section class="grid-resenas">
      {resenasOrdenadas.map((resena) => (
        <article class="card-resena">
          <a href={`/resenas/${resena.id}`} class="card-link">
            <div class="img-container">
              <img src={resena.data.imagen} alt={resena.data.titulo} loading="lazy" />
              <span class="badge-categoria">{resena.data.categoria}</span>
            </div>
            <div class="card-body">
              <h2>{resena.data.titulo}</h2>
              <p class="text-justify">{resena.data.descripcion}</p>
              <div class="card-footer-info">
                <time>
                  {new Date(resena.data.fechaPublicacion).toLocaleDateString('es-ES', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                <span class="cta-link">Ver análisis →</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .resenas-page {
    margin-top: calc(70px + 2rem);
    margin-bottom: 5rem;
    padding: 0 1.5rem;
  }

  .back-link {
    display: inline-block;
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .titulo-pagina {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .descripcion-pagina {
    color: var(--text-muted, #64748b);
    font-size: 1.1rem;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Filtros de categorías */
  .categorias-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
    background: var(--bg-surface, #f8fafc);
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border-color, #e2e8f0);
  }

  .categorias-summary .label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted, #64748b);
  }

  .badges-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .badge-cat-link {
    background: #e2e8f0;
    color: #1e293b;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .badge-cat-link:hover {
    background: #cbd5e1;
  }

  .badge-cat-link.activa {
    background: #2563eb;
    color: #ffffff;
  }

  /* Grid de reseñas */
  .grid-resenas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .card-resena {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card-resena:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .img-container {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-categoria {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-body h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .card-body p {
    color: var(--text-muted, #64748b);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .text-justify {
    text-align: justify;
  }

  .card-footer-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color, #f1f5f9);
  }

  .card-footer-info time {
    font-size: 0.8rem;
    color: var(--text-muted, #64748b);
  }

  .cta-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563eb;
  }

  @media (max-width: 767px) {
    .resenas-page {
      margin-top: calc(60px + 1.5rem);
      padding: 0 1rem;
    }

    .titulo-pagina {
      font-size: 1.6rem;
    }

    .descripcion-pagina {
      font-size: 0.95rem;
    }
  }
</style>