---
// src/pages/resenas/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// 1. Obtenemos todas las reseñas guardadas en src/content/resenas/
const todasLasResenas = await getCollection('resenas');

// 2. Ordenamos las reseñas por fecha de publicación (la más reciente primero)
const resenasOrdenadas = todasLasResenas.sort(
  (a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime()
);

// 3. Extraemos la lista de categorías únicas presentes en las reseñas
const categorias = [...new Set(todasLasResenas.map((resena) => resena.data.categoria))];
---

<Layout title="Análisis y Guías de Compra | Lucioti">
  <Header />

  <main class="container resenas-page">
    <!-- Encabezado optimizado para móviles y enfocado en conversión -->
    <header class="page-header">
      <h1 class="titulo-pagina">Análisis y Recomendaciones de Tecnología</h1>
      <p class="descripcion-pagina">
        ¿Buscas el equipo ideal al mejor precio? Analizamos a fondo los dispositivos más populares del mercado, comparamos su rendimiento real y te mostramos las mejores ofertas disponibles hoy para que elijas con total confianza.
      </p>
    </header>

   <!-- Muestra de categorías disponibles -->
{categorias.length > 0 && (
  <div class="categorias-summary">
    <span class="label">Explora por categoría:</span>
    <div class="badges-group">
      {categorias.map((cat) => {
        // Convertimos el nombre de la categoría a un slug limpio para la URL
        const slugCategoria = cat.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-');
        return (
          <a href={`/resenas/categoria/${slugCategoria}`} class="badge-cat-link">
            {cat}
          </a>
        );
      })}
    </div>
  </div>
)}

    <!-- Grid de publicaciones -->
    <section class="grid-resenas">
      {resenasOrdenadas.map((resena) => (
        <article class="card-resena">
          <a href={`/resenas/${resena.id}`} class="card-link">
            <div class="img-container">
              <img src={resena.data.imagen} alt={resena.data.titulo} loading="lazy" />
              <span class="badge-categoria">{resena.data.categoria}</span>
            </div>
            <div class="card-body">
              <h2>{resena.data.titulo}</h2>
              <p class="text-justify">{resena.data.descripcion}</p>
              <div class="card-footer-info">
                <time>
                  {new Date(resena.data.fechaPublicacion).toLocaleDateString('es-ES', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                <span class="cta-link">Ver análisis →</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .resenas-page {
    margin-top: calc(70px + 2rem);
    margin-bottom: 5rem;
    padding: 0 1.5rem;
  }

  /* Encabezado */
  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .titulo-pagina {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .descripcion-pagina {
    color: var(--text-muted, #64748b);
    font-size: 1.1rem;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Bloque de categorías */
  .categorias-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
    background: var(--bg-surface, #f8fafc);
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border-color, #e2e8f0);
  }

  .categorias-summary .label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted, #64748b);
  }

  .badges-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .badge-cat {
    background: #e2e8f0;
    color: #1e293b;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .badge-cat-link {
  background: #e2e8f0;
  color: #1e293b;
  padding: 0.4rem 0.9rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
}

.badge-cat-link:hover {
  background: #cbd5e1;
  transform: translateY(-2px);
}

  /* Grid de reseñas */
  .grid-resenas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .card-resena {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card-resena:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .img-container {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-categoria {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-body h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .card-body p {
    color: var(--text-muted, #64748b);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .text-justify {
    text-align: justify;
  }

  .card-footer-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color, #f1f5f9);
  }

  .card-footer-info time {
    font-size: 0.8rem;
    color: var(--text-muted, #64748b);
  }

  .cta-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563eb;
  }

  /* Ajustes específicos para dispositivos móviles */
  @media (max-width: 767px) {
    .resenas-page {
      margin-top: calc(60px + 1.5rem);
      padding: 0 1rem;
    }

    .titulo-pagina {
      font-size: 1.6rem;
      padding: 0 0.5rem;
    }

    .descripcion-pagina {
      font-size: 0.95rem;
      padding: 0 0.5rem;
    }

    .page-header {
      margin-bottom: 1.75rem;
    }

    .categorias-summary {
      margin-bottom: 2rem;
      padding: 1rem;
    }
  }
</style>