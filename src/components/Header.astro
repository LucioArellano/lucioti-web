---
// src/components/Header.astro
---
<header class="apple-global-nav">
    <div class="apple-nav-content">
        <!-- Botón Menú Móvil -->
        <button class="apple-menu-icon" id="apple-menu-btn" aria-label="Abrir menú">
            <span class="apple-line apple-line-top"></span>
            <span class="apple-line apple-line-bottom"></span>
        </button>

        <!-- Logo -->
        <a href="/" class="apple-logo-container">
            <img src="/logo.png" alt="Lucioti" class="apple-logo" />
        </a>

        <!-- Enlaces (Escritorio) -->
        <ul class="apple-nav-list" id="apple-nav-list">            
			<li><a href="#servicios" class="apple-link nav-disabled">Soluciones Web</a></li>
            <li><a href="/resenas" class="apple-link">Reseñas</a></li>            
            <li><a href="#servicios" class="apple-link nav-disabled">Cursos</a></li>
        </ul>
    </div>
</header>

<script>
    const menuBtn = document.getElementById('apple-menu-btn');
    const navList = document.getElementById('apple-nav-list');

    if (menuBtn && navList) {
        menuBtn.addEventListener('click', () => {
            menuBtn.classList.toggle('is-open');
            navList.classList.toggle('is-open');
            
            if (navList.classList.contains('is-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });
    }
</script>

<style>
    /* ESTILOS ESPECÍFICOS DEL HEADER */
    .apple-global-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 70px; 
        background: rgba(255, 255, 255, 0.8); 
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        backdrop-filter: saturate(180%) blur(20px);
        z-index: 9999;
        font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    }

    .apple-nav-content { max-width: 980px; margin: 0 auto; padding: 0 22px; height: 100%; display: flex; align-items: center; justify-content: space-between; }
    .apple-logo-container { display: flex; align-items: center; height: 100%; padding: 0 8px; }
    .apple-logo { height: 35px; width: auto; display: block; }
    .apple-nav-list { list-style: none; display: flex; margin: 0; padding: 0; width: 100%; justify-content: flex-end; gap: 32px; }
    .apple-link { font-size: 12px; font-weight: 400; letter-spacing: -.01em; color: #1d1d1f; text-decoration: none; transition: color 0.3s ease; }
    .apple-link:hover { color: #000000; }
    .nav-disabled { opacity: 0.4; cursor: not-allowed; }
    .apple-menu-icon { display: none; background: transparent; border: none; cursor: pointer; width: 18px; height: 44px; position: relative; z-index: 10000; }
    .apple-line { position: absolute; height: 1px; width: 17px; background-color: #1d1d1f; left: 0; transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1); }
    .apple-line-top { top: 19px; }
    .apple-line-bottom { top: 25px; }

    @media (max-width: 768px) {
        .apple-nav-content { justify-content: space-between; }
        .apple-logo-container { order: 1; padding-left: 0; }
        .apple-menu-icon { display: block; order: 2; margin-right: 0; height: 24px; width: 24px; }
        .apple-line { width: 20px; }
        .apple-line-top { top: 8px; }
        .apple-line-bottom { top: 16px; }
        .apple-menu-icon.is-open .apple-line-top { transform: translateY(4px) rotate(45deg); }
        .apple-menu-icon.is-open .apple-line-bottom { transform: translateY(-4px) rotate(-45deg); }
        
        .apple-nav-list {
            position: fixed;
            top: 70px; 
            left: 0;
            width: 100%;
            height: 0; 
            background: #ffffff; 
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            padding: 0 40px;
            gap: 0;
            visibility: hidden;
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.25s ease, transform 0.25s ease, height 0.3s ease, visibility 0s 0.3s;
            border-top: 1px solid #e2e8f0; 
        }

        .apple-nav-list.is-open { visibility: visible; opacity: 1; height: calc(100vh - 70px); padding-top: 20px; transform: translateY(0); transition: opacity 0.3s ease, transform 0.3s ease, height 0.3s ease; }
        .apple-link { font-size: 20px; font-weight: 500; line-height: 1.4; padding: 16px 0; border-bottom: 1px solid #e2e8f0; display: block; width: 100%; color: #1d1d1f; }
    }
</style>